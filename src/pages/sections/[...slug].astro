---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Section from '../../layouts/Section.astro';

export async function getStaticPaths() {
	const sections = await getCollection('sections');
	return sections.map((section) => ({
		params: { slug: section.id },
		props: { section },
	}));
}
type Props = {
	section: CollectionEntry<'sections'>;
};

const { section } = Astro.props;
const { Content } = await render(section);
const sectionTipSlugs = section.data.tips ?? [];
const allTips = sectionTipSlugs.length > 0 ? await getCollection('tips') : [];
const tipsById = new Map(allTips.map((tip) => [tip.id, tip]));
const tips = sectionTipSlugs.map((slug) => {
	const tip = tipsById.get(slug);
	if (!tip) {
		throw new Error(`Section "${section.id}" references missing tip "${slug}"`);
	}
	return tip;
});
---

<Section {...section.data} {tips}>
	<Content />
</Section>