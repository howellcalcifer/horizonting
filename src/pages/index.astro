---
// Component Imports
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import SectionPreview from '../components/SectionPreview.astro';
import { SITE } from '../config';
import { getCollection } from 'astro:content';
import sectionOrder from '../data/section-order.json';

// Component Script:
// You can write any JavaScript/TypeScript that you'd like here.
// It will run during the build, but never in the browser.
// All variables are available to use in the HTML template below.
const { title, description } = SITE;
const permalink = 'https://horizonting.me/';

const sectionPositions = new Map(sectionOrder.sections.map((id, index) => [id, index]));
const allSections = (await getCollection('sections')).sort((a, b) => {
	const aPosition = sectionPositions.get(a.id) ?? Number.POSITIVE_INFINITY;
	const bPosition = sectionPositions.get(b.id) ?? Number.POSITIVE_INFINITY;

	return aPosition - bPosition || a.id.localeCompare(b.id);
});


// Full Astro Component Syntax:
// https://docs.astro.build/core-concepts/astro-components/
---

<html lang="en">
	<head>
		<BaseHead {title} {description} {permalink} />

		<style>
			.content {
				margin-top: 2rem;
				margin-bottom: 8rem;
			}

			.content :global(main > * + *) {
				margin-top: 1rem;
			}

			.section-list {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 2rem;
			}

			@media (max-width: 48em) {
				.section-list {
					grid-template-columns: 1fr;
				}
			}

		</style>
	</head>

	<body>
		<Header showDescription />
		<div class="wrapper">
			<main class="content">
				<section class="section-list" aria-label="Section list">
					{allSections.map((a) => <SectionPreview section={a} />)}
				</section>
			</main>
		</div>
	</body>
</html>
