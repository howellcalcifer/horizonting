---
import { type CollectionEntry, render } from 'astro:content';

interface Props {
	tip: CollectionEntry<'tips'>;
}

const { tip } = Astro.props;
const { Content } = await render(tip);
---

<article class="tip">
	<Content />
</article>

<style>
	.tip {
		min-width: 0;
		padding: 1.25rem 1.5rem;
		border-radius: 0.25rem;
		background: #090d14;
	}
</style>