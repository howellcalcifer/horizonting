---
import { Image } from 'astro:assets';
import bedIcon from '../assets/images/bed_icon.png';
import { SITE } from '../config';
---
<header class="wrapper">
	<section>
		<h1>
			<a href="/">
				<Image class="logo" src={bedIcon} alt="" />
				<span class="branding">
					<span>{SITE.title}</span>
					<span class="description">{SITE.description}</span>
				</span>
			</a>
		</h1>
	</section>
</header>

<style>
	header {
		padding-top: 1rem;
		padding-bottom: 1rem;
		min-height: 10rem;
		display: flex;
		align-items: center;
	}
	section {
		display: flex;
		align-items: center;
	}
	.header-subitem {
		display: flex;
		flex-grow: 0;
		gap: 0.5em;
		align-items: center;
		justify-content: center;
		color: var(--theme-text-lighter);
		font-size: initial;
		padding: 0.5rem;
	}
	.header-subitem:hover {
		color: var(--theme-accent);
	}
	.header-subitem svg {
		width: 1.5rem;
		height: 1.5rem;
	}

	@media (max-width: 32em) {
		.header-subitem {
			display: none;
		}
	}

	h1 {
		margin: 0;
		font-size: 3rem;
		max-width: 100%;
		display: flex;
		flex-grow: 1;
	}

	.logo {
		width: 9rem;
		height: auto;
		flex-shrink: 0;
		margin-right: 1.5rem;
		object-fit: contain;
	}

	svg {
		width: 2.5rem;
		height: 2.5rem;
	}

	h1 a {
		text-decoration: none;
		display: inline-flex;
		align-items: flex-end;
	}

	.branding {
		display: flex;
		flex-direction: column;
	}

	.description {
		color: var(--theme-text-light);
		font-size: 2rem;
		font-weight: 400;
		line-height: 1.4;
	}
</style>
