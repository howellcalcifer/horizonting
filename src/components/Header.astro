---
import { Image } from 'astro:assets';
import bedIcon from '../assets/images/bed_icon.png';
import { SITE } from '../config';

interface Props {
	showDescription?: boolean;
}

const { showDescription = false } = Astro.props;
---
<header class:list={['wrapper', { compact: !showDescription }]}>
	<section>
		<h1>
			<a href="/">
				<Image class="logo" src={bedIcon} alt="" />
				<span class="branding">
					<span>{SITE.title}</span>
					{showDescription && <span class="description">{SITE.description}</span>}
				</span>
			</a>
		</h1>
	</section>
</header>

<style>
	header {
		padding-top: 1rem;
		padding-bottom: 1rem;
		min-height: 10rem;
		display: flex;
		align-items: center;
	}

	header.compact {
		min-height: 7rem;
	}
	section {
		display: flex;
		align-items: center;
	}
	.header-subitem {
		display: flex;
		flex-grow: 0;
		gap: 0.5em;
		align-items: center;
		justify-content: center;
		color: var(--theme-text-lighter);
		font-size: initial;
		padding: 0.5rem;
	}
	.header-subitem:hover {
		color: var(--theme-accent);
	}
	.header-subitem svg {
		width: 1.5rem;
		height: 1.5rem;
	}

	@media (max-width: 32em) {
		.header-subitem {
			display: none;
		}
	}

	h1 {
		margin: 0;
		font-size: 3rem;
		max-width: 100%;
		display: flex;
		flex-grow: 1;
		min-width: 0;
	}

	.compact h1 {
		font-size: 2.25rem;
	}

	.logo {
		width: 9rem;
		height: auto;
		flex-shrink: 0;
		margin-right: 1.5rem;
		object-fit: contain;
	}

	.compact .logo {
		width: 6rem;
		margin-right: 1rem;
	}

	svg {
		width: 2.5rem;
		height: 2.5rem;
	}

	h1 a {
		text-decoration: none;
		display: flex;
		align-items: center;
		width: 100%;
		min-width: 0;
	}

	.branding {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.description {
		color: var(--theme-text-light);
		font-size: 2rem;
		font-weight: 400;
		line-height: 1.4;
		overflow-wrap: anywhere;
	}

	@media (max-width: 50em) {
		h1 {
			font-size: 2.5rem;
		}

		.compact h1 {
			font-size: 2rem;
		}

		.logo {
			width: 6rem;
			margin-right: 1rem;
		}

		.compact .logo {
			width: 5rem;
			margin-right: 0.875rem;
		}

		.description {
			font-size: 1.5rem;
		}
	}

	@media (max-width: 32em) {
		h1 {
			font-size: 2rem;
		}

		.compact h1 {
			font-size: 1.75rem;
		}

		.logo {
			width: 4.5rem;
			margin-right: 0.75rem;
		}

		.compact .logo {
			width: 3.75rem;
			margin-right: 0.625rem;
		}

		.description {
			font-size: 1.25rem;
		}
	}
</style>
