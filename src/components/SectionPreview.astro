---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

export interface Props {
	section: CollectionEntry<'sections'>;
}

const { section } = Astro.props;
const sectionUrl = `/sections/${section.id}`;
---

<a class="section-preview" href={sectionUrl}>
	{section.data.icon && (
		<Image class="icon" src={section.data.icon} alt="" />
	)}
	<div class="preview-content">
		<header>
			<h2 class="title">{section.data.title}</h2>
		</header>
		<p>{section.data.description}</p>
	</div>
</a>

<style>
	.section-preview {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		min-width: 0;
		padding: 1.75rem 1.5rem;
		border-radius: 0.25rem;
		border: 1px solid #05070b;
		background: transparent;
		color: inherit;
		text-decoration: none;
		transition: background-color 150ms ease;
	}

	.section-preview:hover,
	.section-preview:focus-visible {
		background: #05070b;
	}

	.section-preview:hover .title,
	.section-preview:focus-visible .title {
		text-decoration: underline;
	}

	.section-preview:focus-visible {
		outline: 2px solid var(--theme-accent);
		outline-offset: 0.25rem;
	}

	.icon {
		width: clamp(2.5rem, 16%, 5rem);
		height: auto;
		flex: 0 0 auto;
		object-fit: contain;
	}

	.preview-content {
		min-width: 0;
	}

	header {
		align-items: flex-start;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding-bottom: 2rem;
		text-align: left;
	}

	.title {
		margin: 0;
	}

	.title {
		font-size: 1.75rem;
		font-weight: 700;
		color: var(--theme-text);
	}

	@media (prefers-reduced-motion: reduce) {
		.section-preview {
			transition: none;
		}
	}
</style>
