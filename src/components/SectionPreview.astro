---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

export interface Props {
	section: CollectionEntry<'sections'>;
}

const { section } = Astro.props;
const sectionUrl = `/sections/${section.id}`;
---

<section class="section-preview">
	{section.data.icon && (
		<Image class="icon" src={section.data.icon} alt="" />
	)}
	<div class="preview-content">
		<header>
			<a href={sectionUrl}><h2 class="title">{section.data.title}</h2></a>
		</header>
		<p>{section.data.description}</p>
		<a href={sectionUrl}>Read more</a>
	</div>
</section>

<style>
	.section-preview {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		min-width: 0;
		padding-bottom: 2rem;
		border-bottom: 4px solid var(--theme-divider);
	}

	.icon {
		width: clamp(3rem, 20%, 6rem);
		height: auto;
		flex: 0 0 auto;
		object-fit: contain;
	}

	.preview-content {
		min-width: 0;
	}

	header {
		align-items: flex-start;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding-bottom: 2rem;
		text-align: left;
	}

	.title {
		margin: 0;
	}

	.title {
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--theme-text);
	}
</style>
