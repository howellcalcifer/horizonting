---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

export interface Props {
	article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const articleUrl = `/articles/${article.id}`;
---

<article class="article-preview">
	{article.data.icon && (
		<Image class="icon" src={article.data.icon} alt="" />
	)}
	<div class="preview-content">
		<header>
			<a href={articleUrl}><h2 class="title">{article.data.title}</h2></a>
		</header>
		<p>{article.data.description}</p>
		<a href={articleUrl}>Read more</a>
	</div>
</article>

<style>
	.article-preview {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		min-width: 0;
		padding-bottom: 2rem;
		border-bottom: 4px solid var(--theme-divider);
	}

	.icon {
		width: clamp(3rem, 20%, 6rem);
		height: auto;
		flex: 0 0 auto;
		object-fit: contain;
	}

	.preview-content {
		min-width: 0;
	}

	header {
		align-items: flex-start;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding-bottom: 2rem;
		text-align: left;
	}

	.title {
		margin: 0;
	}

	.title {
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--theme-text);
	}
</style>
