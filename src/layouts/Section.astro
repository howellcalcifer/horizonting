---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Section from '../components/Section.astro';

const { title, description, pubDate, alt, lang, permalink, tips } = Astro.props;
---

<html lang={lang || 'en'}>
	<head>
		<BaseHead {title} {description} {permalink} />
	</head>

	<body>
		<Header />
		<div class="wrapper">
			<Section {title} {pubDate} {alt} {tips}>
				<slot />
			</Section>
		</div>
	</body>
</html>
